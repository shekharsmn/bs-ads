APP_NAME=SharkAds
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAINS=brandshark.com,second-domain.com
GOOGLE_WORKSPACE_BOOTSTRAP_ADMIN_EMAIL=

AD_LIBRARY_ENABLED=false
AD_LIBRARY_SCRAPER_URL=http://127.0.0.1:8090
AD_LIBRARY_SCRAPER_TOKEN=
AD_LIBRARY_CONNECT_TIMEOUT=5
AD_LIBRARY_READ_TIMEOUT=780
AD_LIBRARY_MAX_RESPONSE_BYTES=26214400
AD_LIBRARY_AUDITS_ENABLED=false
AD_LIBRARY_AUDIT_MAX_CREATIVES=50
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_HEARTBEAT_TTL_SECONDS=180
WORKFLOW_ATTEMPT_STALE_MINUTES=20
OPERATIONS_HEARTBEATS_REQUIRED=false
METRIC_RETENTION_DAYS=400

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Ads API (OAuth web client + developer token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match Google Cloud Console authorized redirect URI (use Vite dev origin + /api path)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_COMPLETE_URL=http://localhost:5173/accounts/google/callback
