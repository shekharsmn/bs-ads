FROM node:22-alpine AS shopify
WORKDIR /shopify-app
COPY shopify-app/package*.json ./
RUN npm ci --no-audit --no-fund
COPY shopify-app/ ./
ENV NODE_OPTIONS=--max-old-space-size=512
RUN npm run build

FROM node:22-alpine AS agency
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ENV NODE_OPTIONS=--max-old-space-size=512
RUN npm run build

FROM nginx:1.28-alpine
COPY --from=agency /app/dist /usr/share/nginx/html
COPY --from=shopify /backend/public/shopify /usr/share/nginx/html/shopify
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
